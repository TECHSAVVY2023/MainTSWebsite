# PayMongo checkout + webhook sample config
PAYMONGO_PUBLIC_BASE_URL=https://your-tunnel.example.ngrok-free.dev

# MUST be the signing secret from PayMongo → Webhooks → your endpoint → "Signing secret" (starts with whsk_)
# Do NOT paste the webhook URL here — that breaks signature verification and orders never become "paid".
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_signing_secret_here

PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key_here
