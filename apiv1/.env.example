# Copy to .env and adjust. PayMongo merch checkout + webhooks
PAYMONGO_PUBLIC_BASE_URL=https://your-tunnel.example.ngrok-free.dev
PAYMONGO_WEBHOOK_SECRET=whsk_...
PAYMONGO_SECRET_KEY=sk_test_...

# Receipt emails (guest merchandise) — default prints to console in dev
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL="Tech Savvy <noreply@yourdomain.com>"

