# -----------------------------------------------------------------------------
# PayMongo webhooks — copy this file to `.env` in this folder (next to manage.py)
#   PowerShell:  Copy-Item .env.example .env
# Then paste your signing secret from: PayMongo Dashboard → Webhooks → your webhook → Show secret (whsk_...)
#
# Tunnel (expose Django on port 8000):
#   ngrok http 8000
# Webhook URL in PayMongo (append /webhooks/paymongo/ to the https URL ngrok shows):
#   https://YOUR-SUBDOMAIN.ngrok-free.app/webhooks/paymongo/
#
# Restart after editing:  python manage.py runserver 0.0.0.0:8000
# Check: GET http://127.0.0.1:8000/webhooks/paymongo/health/  → "configured": true
# Optional: HTTPS public host only (ngrok), no path — health JSON will show full webhook URL to paste.
# PAYMONGO_PUBLIC_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.dev

PAYMONGO_WEBHOOK_SECRET=

# Secret API key (Dashboard → Developers → API keys) — server-only, never expose to the browser.
# PAYMONGO_SECRET_KEY=sk_test_xxxxxxxx
# Optional: narrow payment methods if PayMongo returns errors (comma-separated).
# PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,paymaya,qrph
